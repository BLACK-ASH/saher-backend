PORT=4000
# Not Required In Production
NODE_ENV="development"

# --- Required at boot (validated in src/config/env.ts, app refuses to start if invalid) ---
MONGO_URI=mongodb://localhost:27017/saher
REDIS_URL=redis://localhost:6379
# PUBLIC https origin of the app — used in mail links, verify/reset URLs and
# notification download actions (nginx proxies this to the frontend/backend)
BASE_URL=https://development.saherindia.org

# 32+ chars. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
CRON_SECRET=

# Resend dashboard key (re_...)
RESEND_API_KEY=

# VAPID keys for web push. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

GOOGLE_API_KEY=

# Comma-separated browser origins allowed for credentialed CORS (e.g. https://app.saherindia.org).
# Unset = any origin reflected (dev only). Set = strict allowlist; also required in prod
# for cross-site cookies (sameSite:'none') — without it cookies fall back to sameSite:'lax'.
CORS_ORIGINS=

# First-admin bootstrap for `pnpm seed` only (password 12+ chars).
# This account is the application entrypoint — set strong values before seeding.
SEED_ADMIN_EMAIL=admin@saher.com
SEED_ADMIN_PASSWORD=

# Not Required In Production
CLIENT_URL=http://localhost:3000
